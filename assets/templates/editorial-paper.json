{
  "_meta": {
    "template": "editorial-paper",
    "use_when": "杂志/编辑风纸感主视觉：高客单、设计感强、强调品牌调性的商品；也适合把主视觉与详情页做成同一套视觉语言",
    "reference": "米色纸纹 + 超大高对比衬线标题（错位两行）+ 铜色唯一强调色 + 极细圆/十字坐标/虚线 + 竖排字距英文 + 圆环数据徽章 + 底部品牌行与行动语",
    "must_replace": ["brand", "headline_line1", "headline_line2", "product_name", "bullets", "price", "date", "cta", "vertical_accent"],
    "notes": [
      "底图用 scripts/make_paper_base.py 生成；商品图与 Logo 请换成真实素材并把 optional 改为 false",
      "字体默认思源宋体（Noto Serif SC）可变字重；若该机器未安装，脚本会告警并回退系统字体",
      "铜色是唯一强调色，品牌色只出现在 Logo，避免与商品撞色"
    ],
    "warning": "示例文案仅供版式演示，交付前必须替换为真实商品信息"
  },
  "project": "kv-editorial-paper",
  "lang": "zh",
  "canvas": { "width": 1200, "height": 1500, "background": "#EDE5D8" },
  "fonts": {
    "serif-display": { "path": "NotoSerifSC-VF.ttf", "variation": "Black" },
    "serif-medium": { "path": "NotoSerifSC-VF.ttf", "variation": "Medium" },
    "serif-regular": { "path": "NotoSerifSC-VF.ttf", "variation": "Regular" },
    "serif-light": { "path": "NotoSerifSC-VF.ttf", "variation": "Light" }
  },
  "background_image": { "path": "work/base/base-cn.png", "fit": "cover", "optional": true },
  "layers": [
    { "type": "ellipse", "box": [150, 330, 900, 900], "outline": { "color": "#B5773F55", "width": 2 } },

    { "type": "text", "text": "秋季限时促销 · 2026", "box": [640, 62, 500, 40], "font": "serif-light",
      "size": 24, "letter_spacing": 8, "color": "#B5773F", "align": "right", "valign": "middle" },
    { "type": "image", "path": "work/base/logo.png", "box": [60, 56, 48, 48], "fit": "contain",
      "optional": true },
    { "type": "text", "text": "BRAND", "box": [120, 50, 300, 62], "font": "serif-medium",
      "size": 46, "letter_spacing": 14, "color": "#1C1A17", "valign": "middle" },

    { "type": "text", "text": "轻装出行", "box": [60, 148, 900, 215], "font": "serif-display",
      "size": 176, "letter_spacing": 4, "color": "#1C1A17" },
    { "type": "text", "text": "温度随行", "box": [180, 366, 900, 215], "font": "serif-display",
      "size": 176, "letter_spacing": 4, "color": "#B5773F" },

    { "type": "shadow", "path": "work/base/product-cutout.png", "box": [223, 446, 755, 943],
      "fit": "contain", "blur": 30, "offset": [8, 22], "opacity": 0.30, "color": "#3A3226",
      "optional": true },
    { "type": "image", "path": "work/base/product-cutout.png", "box": [223, 446, 755, 943],
      "fit": "contain", "optional": true },

    { "type": "text", "text": "BRAND 600 mL\n不锈钢保温杯", "box": [60, 630, 380, 100], "font": "serif-medium",
      "size": 30, "line_spacing": 1.42, "color": "#2A2620", "max_lines": 2 },

    { "type": "line", "points": [[60, 780], [440, 780]], "color": "#1C1A1738", "width": 2 },
    { "type": "list", "box": [60, 820, 380, 300], "size": 28, "gap": 22, "line_spacing": 1.35,
      "font": "serif-regular", "color": "#2A2620",
      "marker": { "type": "dot", "color": "#B5773F", "size": 10, "gap": 16 },
      "items": ["316 不锈钢内胆", "12 小时保温保冷", "一键锁扣 防漏随行"] },
    { "type": "line", "points": [[60, 1140], [440, 1140]], "color": "#1C1A1738", "width": 2 },

    { "type": "text", "text": "秋日出行价", "box": [60, 1155, 420, 38], "font": "serif-light",
      "size": 24, "letter_spacing": 10, "color": "#B5773F", "valign": "middle" },
    { "type": "text", "box": [60, 1193, 450, 145], "valign": "middle",
      "spans": [
        { "text": "129", "size": 132, "weight": "black", "font": "serif-display", "color": "#1C1A17" },
        { "text": " 元", "size": 44, "weight": "medium", "font": "serif-medium", "color": "#1C1A17" }
      ] },
    { "type": "text", "text": "活动时间 2026 年 10 月 1 日至 10 月 15 日", "box": [60, 1340, 660, 38],
      "font": "serif-regular", "size": 23, "letter_spacing": 1, "color": "#6E6659" },

    { "type": "ellipse", "box": [890, 760, 240, 240], "outline": { "color": "#B5773F99", "width": 2 } },
    { "type": "text", "text": "CAPACITY", "box": [890, 792, 240, 30], "font": "serif-light",
      "size": 17, "letter_spacing": 8, "color": "#B5773F", "align": "center" },
    { "type": "text", "text": "600", "box": [890, 828, 240, 90], "font": "serif-display",
      "size": 60, "color": "#1C1A17", "align": "center", "valign": "middle" },
    { "type": "text", "text": "mL", "box": [890, 918, 240, 36], "font": "serif-light",
      "size": 20, "letter_spacing": 6, "color": "#6E6659", "align": "center" },

    { "type": "ellipse", "box": [1084, 274, 12, 12], "fill": "#B5773F" },
    { "type": "text", "text": "T\nR\nA\nV\nE\nL\n·\nL\nI\nG\nH\nT", "box": [1040, 302, 100, 420],
      "font": "serif-light", "size": 20, "line_spacing": 1.25, "color": "#6E6659", "align": "center" },

    { "type": "ellipse", "box": [820, 1090, 150, 150], "outline": { "color": "#B5773F73", "width": 2 } },
    { "type": "line", "points": [[895, 1065], [895, 1265]], "color": "#B5773F59", "width": 1 },
    { "type": "line", "points": [[795, 1165], [995, 1165]], "color": "#B5773F59", "width": 1 },
    { "type": "ellipse", "box": [891, 1061, 8, 8], "fill": "#B5773F" },
    { "type": "ellipse", "box": [891, 1261, 8, 8], "fill": "#B5773F" },
    { "type": "ellipse", "box": [791, 1161, 8, 8], "fill": "#B5773F" },
    { "type": "ellipse", "box": [991, 1161, 8, 8], "fill": "#B5773F" },
    { "type": "line", "points": [[1060, 1050], [1060, 1340]], "color": "#B5773F99", "width": 2,
      "dash": [2, 12] },
    { "type": "ellipse", "box": [1056, 1030, 8, 8], "fill": "#B5773F" },
    { "type": "ellipse", "box": [1056, 1344, 8, 8], "fill": "#B5773F" },

    { "type": "line", "points": [[60, 1392], [1140, 1392]], "color": "#1C1A1738", "width": 2 },
    { "type": "text", "text": "STAINLESS STEEL TRAVEL TUMBLER", "box": [60, 1404, 620, 40],
      "font": "serif-light", "size": 20, "letter_spacing": 4, "word_spacing": 3.2,
      "color": "#6E6659", "valign": "middle" },
    { "type": "text", "text": "立即选购", "box": [860, 1400, 280, 44], "font": "serif-medium",
      "size": 26, "letter_spacing": 4, "color": "#1C1A17", "align": "right", "valign": "middle" },
    { "type": "line", "points": [[1036, 1446], [1140, 1446]], "color": "#B5773F", "width": 2 }
  ]
}
